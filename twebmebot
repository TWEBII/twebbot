                font = ImageFont.truetype(FONT_PATH, font_size) if os.path.exists(FONT_PATH) else ImageFont.load_default()
                
                draw_perfect_arabic_text(draw, translated, w, h, font)
                
                combined = Image.new("RGB", (w, h * 2))
