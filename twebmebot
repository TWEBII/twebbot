                        if not text_content.strip():
                            text_content = pytesseract.image_to_string(orig_img, lang='ara+eng')
                            
                        translated = translate_text(text_content, target_lang='ar') if text_content.strip() else "لا يوجد نص في هذه الصفحة."
                        
                        trans_img = Image.new("RGB", (w, h), "white")
                        draw = ImageDraw.Draw(trans_img)
                        font_size = int(h * 0.025) if int(h * 0.025) > 12 else 16
                        font = ImageFont.truetype(FONT_PATH, font_size) if os.path.exists(FONT_PATH) else ImageFont.load_default()
                        
                        draw_perfect_arabic_text(draw, translated, w, h, font)
                            
                        combined = Image.new("RGB", (w, h * 2))
                        combined.paste(orig_img, (0, 0))
                        combined.paste(trans_img, (0, h))
                        pages_images.append(combined)
                        safe_remove_file(temp_page_img_path)
                    doc.close()
                else:
                    bot.edit_message_text("⚠️ مكتبة معالجة الـ PDF (fitz) غير متوفرة على الخادم.", chat_id=user_id, message_id=status_msg.message_id)
                    safe_remove_file(temp_doc_path)
                    return
                safe_remove_file(temp_doc_path)

            if pages_images:
                bot.edit_message_text("⏳ جاري حفظ وتصدير الملف النهائي بصيغة PDF... 95%", chat_id=user_id, message_id=status_msg.message_id)
                translated_pdf_path = f"final_translated_{user_id}_{uuid.uuid4().hex[:6]}.pdf"
                pages_images[0].save(translated_pdf_path, save_all=True, append_images=pages_images[1:])
                
                bot.edit_message_text("🚀 اكتملت العملية بنجاح! جاري إرسال الملف...", chat_id=user_id, message_id=status_msg.message_id)
                with open(translated_pdf_path, 'rb') as final_pdf:
                    bot.send_document(
                        user_id,
                        final_pdf,
                        caption="📄 **تم ترجمة الملف بنجاح بواسطة بوت TWEB** ✨",
                        parse_mode="Markdown"
                    )
                safe_remove_file(translated_pdf_path)
            else:
                bot.edit_message_text("⚠️ لم يتم استخراج أي صفحات لترجمتها.", chat_id=user_id, message_id=status_msg.message_id)
        except Exception as e:
            logger.error(f"File Translation Error: {e}")
            bot.edit_message_text(f"⚠️ حدث خطأ أثناء معالجة وترجمة الملف: {e}", chat_id=user_id, message_id=status_msg.message_id)
            if translated_pdf_path:
                safe_remove_file(translated_pdf_path)
        return

    elif call.data == "user_menu_support":
        bot.answer_callback_query(call.id)
        today = datetime.datetime.now(pytz.timezone('Asia/Baghdad')).strftime('%Y-%m-%d')
        if db.get("support_logs", {}).get(str(user_id)) == today:
            bot.send_message(user_id, "⚠️ يُسمح بإرسال رسالة دعم واحدة يومياً.")
            return
        msg = bot.send_message(user_id, "🛠 يرجى كتابة تفاصيل المشكلة في رسالة واحدة ليتم توجيهها للمطور:")
        bot.register_next_step_handler(msg, process_user_support_message, today)
        return

    elif call.data == "user_menu_guide":
        bot.answer_callback_query(call.id)
        guide_text = (
            "❓ **دليل استخدام بوت TWEB:**\n\n"
            "• للتحميل من السوشيال ميديا: أرسل أي رابط فيديو أو منشور.\n"
            "• لترجمة الملفات والصور: أرسل الملف أو الصورة ثم اختر (ترجمة).\n"
            "• للألعاب والترفيه: استخدم قسم الألعاب لجمع النقاط والتسلية.\n"
            "• لمواقيت الصلاة: اضغط على زر مواقيت الصلاة لتحديد محافظتك بدقة."
        )
        markup = InlineKeyboardMarkup()
        markup.add(InlineKeyboardButton("« رجوع للقائمة السابقة 🔙", callback_data="user_back_home"))
        edit_user_interface(call, guide_text, markup)
        return

@app.route(f"/{TOKEN}", methods=['POST'])
def webhook():
    if request.headers.get('content-type') == 'application/json':
        json_string = request.get_data().decode('utf-8')
        update = telebot.types.Update.de_json(json_string)
        bot.process_new_updates([update])
        return '', 200
    else:
        return '', 403

