def get_random_kut_question():
    if not KUT_SUPPORT:
        return None
    try:
        if hasattr(kut_questions, 'get_random_question'):
            res = kut_questions.get_random_question()
            if isinstance(res, str) and res.strip():
                return res
        
        if hasattr(kut_questions, 'QUESTIONS_LIST') and isinstance(kut_questions.QUESTIONS_LIST, list):
            q_list = kut_questions.QUESTIONS_LIST
            if q_list:
                item = random.choice(q_list)
                if isinstance(item, str):
                    return item
                elif isinstance(item, dict):
                    return item.get('text') or item.get('question') or str(item)

        candidates = []
        for attr in dir(kut_questions):
            if attr.startswith('_'): continue
            val = getattr(kut_questions, attr)
            if isinstance(val, list) and val:
                candidates.extend(val)
            elif isinstance(val, dict) and val:
                for sub_v in val.values():
                    if isinstance(sub_v, list):
                        candidates.extend(sub_v)
        
        if candidates:
            chosen = random.choice(candidates)
            if isinstance(chosen, str):
                return chosen
            elif isinstance(chosen, dict):
                return chosen.get('text') or chosen.get('question') or str(chosen)
    except Exception as e:
        logger.error(f"Error getting kut question: {e}")
    return None

