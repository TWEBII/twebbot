def load_db():
    default_data = {
        "users": [], "banned_users": [], "notified_users": [],
        "bot_active": True, "start_text": "أهلاً بك في بوت الذكاء الاصطناعي TWEB! كيف يمكنني مساعدتك اليوم؟",
        "custom_buttons": [], "support_logs": {}, "user_instructions": {},
        "msg_counters": {}, "login_notice": True, "user_provinces": {}, "user_districts": {}, "user_madhabs": {}, "manual_offsets": {},
        "riddle_scores": {}, "active_riddles": {}, "game_accounts": {}, "game_points": {}, "pending_game_provinces": {}
    }
    
    if db_collection is not None:
        try:
            doc = db_collection.find_one({"_id": "main_data"})
            if doc:
                doc.pop("_id", None)
                for key, val in default_data.items():
                    if key not in doc:
                        doc[key] = val
                if "login_notice" not in doc: doc["login_notice"] = True
                if "notified_users" not in doc: doc["notified_users"] = []
                if "user_provinces" not in doc: doc["user_provinces"] = {}
                if "user_districts" not in doc: doc["user_districts"] = {}
                if "user_madhabs" not in doc: doc["user_madhabs"] = {}
                if "manual_offsets" not in doc: doc["manual_offsets"] = {}
                if "riddle_scores" not in doc: doc["riddle_scores"] = {}
                if "active_riddles" not in doc: doc["active_riddles"] = {}
                if "game_accounts" not in doc: doc["game_accounts"] = {}
                if "game_points" not in doc: doc["game_points"] = {}
                if "pending_game_provinces" not in doc: doc["pending_game_provinces"] = {}
                return doc
        except Exception as e:
            logger.error(f"Error loading DB from MongoDB: {e}")

    # Fallback to local file if MongoDB fails
    if os.path.exists(DB_FILE):
        try:
            with open(DB_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                for key, val in default_data.items():
                    if key not in data:
                        data[key] = val
                return data
        except Exception as e:
            logger.error(f"Error loading DB locally: {e}")
            
    return default_data

def save_db(db):
    if db_collection is not None:
        try:
            data_to_save = dict(db)
            data_to_save["_id"] = "main_data"
            db_collection.replace_one({"_id": "main_data"}, data_to_save, upsert=True)
            return
        except Exception as e:
            logger.error(f"Error saving DB to MongoDB: {e}")
            
    # Fallback to local file if MongoDB fails
    try:
        with open(DB_FILE, "w", encoding="utf-8") as f:
            json.dump(db, f, ensure_ascii=False, indent=4)
    except Exception as e:
        logger.error(f"Error saving DB locally: {e}")

