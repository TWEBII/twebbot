            pages_images = []

            def draw_perfect_arabic_text(draw, text_string, width, height, font):
                paragraphs = text_string.split('\n')
                lines = []
                max_allowed_width = width - int(width * 0.1)
                
                for p in paragraphs:
                    if not p.strip():
                        lines.append("")
                        continue
                    words = p.split(' ')
                    current_line = ""
                    for word in words:
                        test_line = f"{current_line} {word}".strip() if current_line else word
                        try:
                            if ARABIC_SUPPORT:
                                reshaped_test = arabic_reshaper.reshape(test_line)
                                bidi_test = get_display(reshaped_test)
                            else:
                                bidi_test = test_line
                            try:
                                bbox = draw.textbbox((0, 0), bidi_test, font=font)
                                line_w = bbox[2] - bbox[0]
                            except AttributeError:
                                line_w, _ = draw.textsize(bidi_test, font=font)
                        except Exception:
                            line_w = len(test_line) * 10
                            
                        if line_w <= max_allowed_width:
                            current_line = test_line
                        else:
                            if current_line:
                                lines.append(current_line)
                            current_line = word
                    if current_line:
                        lines.append(current_line)

                y_offset = int(height * 0.05)
                line_spacing = int((font.size if hasattr(font, 'size') else 16) * 1.6)

                for line in lines:
                    if not line.strip():
                        y_offset += line_spacing
                        continue
                    if ARABIC_SUPPORT:
                        try:
                            reshaped_text = arabic_reshaper.reshape(line)
                            bidi_text = get_display(reshaped_text)
                        except Exception:
                            bidi_text = line
                    else:
                        bidi_text = line

                    try:
                        bbox = draw.textbbox((0, 0), bidi_text, font=font)
                        line_w = bbox[2] - bbox[0]
                    except AttributeError:
                        line_w, _ = draw.textsize(bidi_text, font=font)

                    x_pos = width - line_w - int(width * 0.05)
                    if x_pos < int(width * 0.05):
                        x_pos = int(width * 0.05)

                    draw.text((x_pos, y_offset), bidi_text, font=font, fill="black")
                    y_offset += line_spacing

            if repl_msg.photo:
                bot.edit_message_text("⏳ جاري تحميل الصورة الأصلية... 20%", chat_id=user_id, message_id=status_msg.message_id)
