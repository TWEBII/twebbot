@bot.message_handler(func=lambda m: m.text and not m.text.startswith('/'), content_types=['text'])
def handle_user_messages(message):
    db = load_db()
    user_id = message.from_user.id
    text = (message.text or "").strip().lower()
    chat_id_str = str(message.chat.id)
    
    if str(user_id) in db.get("banned_users", []) or (message.from_user.username and message.from_user.username in db.get("banned_users", [])): return
    if not db.get("bot_active", True) and str(user_id) != ADMIN_ID: return

    if str(user_id) != ADMIN_ID and message.from_user.username != "TWEBii":
        if not check_subscription(user_id):
            bot.send_message(
                message.chat.id,
                "عذرا عزيزي عليك الإشتراك بقناة البوت الرسميه اتمكن من استخدامه",
                reply_markup=sub_keyboard()
            )
            return

    # --- التفاعل مع إجابات أسئلة الكت (سواء في الخاص أو المجموعات) عند الرد على رسالة البوت ---
    my_bot_id = get_bot_id()
    is_reply_to_bot = (message.reply_to_message and my_bot_id and message.reply_to_message.from_user.id == my_bot_id)
    
    if is_reply_to_bot and message.reply_to_message.text and message.reply_to_message.text.startswith("🎯"):
        prompt_opinion = (
            f"المستخدم رد على سؤال الكت الخاص بك ('{message.reply_to_message.text}') بإجابته التالية: ('{message.text}'). "
            f"أعطِ رأيك المختصر واللطيف أو الساخِر قليلاً بإجابة المستخدم بعبارة قصيرة جداً باللغة العربية الفصحى."
        )
        bot.send_chat_action(message.chat.id, 'typing')
        bot.reply_to(message, get_ai_reply(message, prompt_opinion))
        return

    active_riddles = db.get("active_riddles", {})
    if chat_id_str in active_riddles:
        current_riddle = active_riddles[chat_id_str]
        correct_ans = current_riddle["answer"]
        
        if correct_ans in text or text in correct_ans:
            u_id_game = current_riddle.get("user_id", user_id)
            if not check_game_account_registered(u_id_game):
                bot.reply_to(message, "⚠️ إجابتك صحيحة، ولكن لم يتم تسجيل حساب ألعاب لك لتلقي النقاط!")
                del db["active_riddles"][chat_id_str]
                save_db(db)
                return

            add_game_points(u_id_game, 5)
            
            user_key = str(u_id_game)
            if "riddle_scores" not in db: db["riddle_scores"] = {}
            if user_key not in db["riddle_scores"]:
                db["riddle_scores"][user_key] = {"name": message.from_user.first_name, "score": 0}
            
            db["riddle_scores"][user_key]["score"] += 1
            del db["active_riddles"][chat_id_str]
            save_db(db)
            
            name = message.from_user.first_name
            bot.reply_to(message, f"🎉 كفو يا بطل **{name}**! إجابتك صحيحة وتمت إضافة **5 نقاط** لرصيدك في الحوازير وحساب الألعاب 🏆.")
            return
        else:
            current_riddle["attempts_left"] -= 1
            remaining = current_riddle["attempts_left"]
            
            if remaining <= 0:
                ans_reveal = current_riddle["answer"]
                del db["active_riddles"][chat_id_str]
                save_db(db)
                bot.reply_to(message, f"❌ انتهت محاولاتكم الثلاثة للأسف!\n💡 الجواب الصحيح كان: `{ans_reveal}`", parse_mode="Markdown")
                return
            else:
                save_db(db)
                bot.reply_to(message, f"❌ إجابة خاطئة! متبقي لديك `{remaining}` محاولات فقط لهذه الحزورة.")
                return

    if message.chat.type in ['group', 'supergroup']:
        if not (any(name in text for name in ["تويب", "Tweb", "TWEB", "أحمد", "احمد"]) or is_reply_to_bot):
            return

    user_key = str(user_id)
    counters = db.get("msg_counters", {})
    counters[user_key] = counters.get(user_key, 0) + 1
    db["msg_counters"] = counters; save_db(db)

    features_keywords = [
        "ماذا تستطيع", "ماذا تفعل", "وش تسوي", "شنو تسوي", "وش تكدر تسوي",
        "شنو تكدر تسوي", "مميزاتك", "خدماتك", "مهامك", "وش هي مهامك",
        "شنو هي مهامك", "طريقة استخدامك", "أشياء تفعلها", "اشياء تفعلها"
    ]
    if any(keyword in text for keyword in features_keywords):
        help_text = (
            "🤖 **أهلاً بك! أنا مساعدك الذكي TWEB، وإليك خدماتي:**\n\n"
            "📥 **1. التحميل من السوشيال ميديا:** أرسل الرابط مباشرة للتحميل كفيديو أو صوت.\n"
            "🎬 **2. بث ومشاهدة المحاضرات:** أرسل أي فيديو أو محاضرة للحصول على روابط مشاهدة.\n"
            "📄 **3. ترجمة وتعديل الملفات:** أرسل ملف PDF أو صورة لعرض خيارات الترجمة وتعديل وإرسال الملف كـ PDF.\n"
            "🌙 **4. الأذكار والتنبيهات الدينية تلقائياً:** أذكار الصباح والنوم، ومناسبات التقويم الهجري.\n"
            "🕌 **5. مواقيت الصلاة:** عرض أوقات الصلاة الدقيقة حسب الوقف السني ومحافظتك والقضائك والمذهب في العراق مع إمكانية التعديل اليدوي.\n"
            "🎮 **6. الألعاب والحوازير:** العب XO (10 نقاط), حجرة ورقة مقص (10 نقاط), أسئلة الكت (0.5 نقطة), والحوازير (5 نقاط) مع لوحة نقاط تفاعلية.\n"
            "🧠 **7. الإجابة الذكية:** أجب عن كافة استفساراتك العامة بالفصحى.\n"
            "🛠 **8. التخصيص والدعم:** حدد شروط التعامل المفضلة للبوت معك من القائمة."
        )
        bot.send_chat_action(message.chat.id, 'typing')
        bot.reply_to(message, help_text, parse_mode="Markdown")
        if counters[user_key] % 5 == 0: send_random_sticker(message.chat.id)
        return

    bot.send_chat_action(message.chat.id, 'typing')
    bot.reply_to(message, get_ai_reply(message, text))
    if counters[user_key] % 5 == 0: send_random_sticker(message.chat.id)

@bot.message_handler(func=lambda m: m.text and m.text.strip().lower() in ["أيدي", "ايدي", "/id", "/ID"])
def handle_user_id_card(message):
    db = load_db()
    user_id = message.from_user.id
    if str(user_id) in db.get("banned_users", []):
        return

    target_user = message.reply_to_message.from_user if message.reply_to_message else message.from_user
    target_id = target_user.id

    name = target_user.first_name
    if target_user.last_name:
        name += f" {target_user.last_name}"
    
    username = f"@{target_user.username}" if target_user.username else "لا يوجد"

    status_text = "عضو"
    try:
        if message.chat.type in ['group', 'supergroup']:
            member = bot.get_chat_member(message.chat.id, target_id)
            if member.status == 'creator':
                status_text = "منشئ المجموعة"
            elif member.status == 'administrator':
                status_text = "مشرف"
            elif member.status == 'member':
                status_text = "عضو"
            elif member.status == 'restricted':
                status_text = "مقيد"
    except Exception:
        pass

    bio = ""
    try:
        chat_info = bot.get_chat(target_id)
        if hasattr(chat_info, 'bio') and chat_info.bio:
            bio = chat_info.bio
    except Exception:
        pass

    cr_text = "2022/08"

    caption = (
        f"𖡋 𝐍𝐀𝐌 ⌯  {name}\n"
        f"𖡋 𝐔𝐒𝐄 ⌯  {username}\n"
        f"𖡋 𝐒𝐓𝐀 ⌯  {status_text}\n"
        f"𖡋 𝐈𝐃 ⌯  {target_id}\n"
        f"𖡋 𝐂𝐑  ⌯  {cr_text}\n"
        f"{bio}"
    )

    try:
        photos = bot.get_user_profile_photos(target_id, limit=1)
        if photos.total_count > 0:
            file_id = photos.photos[0][-1].file_id
            bot.send_photo(message.chat.id, file_id, caption=caption, reply_to_message_id=message.message_id)
        else:
            bot.send_message(message.chat.id, caption, reply_to_message_id=message.message_id)
    except Exception as e:
        logger.error(f"Error sending ID card photo: {e}")
        bot.send_message(message.chat.id, caption, reply_to_message_id=message.message_id)

